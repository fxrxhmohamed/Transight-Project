/// semantic.dq_rule_checks: one row per run and rule of the first validation round.
table dq_rule_checks
	lineageTag: 6bac807a-25c8-501e-bbce-76c6ab0392d4

	/// values_checked: sum(checked), first validation round
	measure 'Values Checked' = SUM ( 'dq_rule_checks'[checked] )
		formatString: #,0
		displayFolder: DQ Rules
		lineageTag: 1e152549-2412-50ee-974f-068a2a4523bb

	/// values_failed: sum(failed)
	measure 'Values Failed' = SUM ( 'dq_rule_checks'[failed] )
		formatString: #,0
		displayFolder: DQ Rules
		lineageTag: 74d69220-1965-5783-96f6-191805086297

	/// values_repaired: sum(repaired)
	measure 'Values Repaired' = SUM ( 'dq_rule_checks'[repaired] )
		formatString: #,0
		displayFolder: DQ Rules
		lineageTag: a7873a1d-e65e-56eb-a3d1-59390f032afd

	/// sum(unresolved)
	measure 'Values Unresolved' = SUM ( 'dq_rule_checks'[unresolved] )
		formatString: #,0
		displayFolder: DQ Rules
		lineageTag: 7d94895d-ea93-5c9a-9f6a-ed50f1e2ed5c

	/// rule_failure_rate: values_failed / values_checked
	measure 'Rule Failure Rate %' = DIVIDE ( [Values Failed], [Values Checked] )
		formatString: 0.000%
		displayFolder: DQ Rules
		lineageTag: 75c72475-f123-5261-bc7a-d50e50420e03

	/// rule_repair_rate: values_repaired / values_failed
	measure 'Rule Repair Rate %' = DIVIDE ( [Values Repaired], [Values Failed] )
		formatString: 0.0%
		displayFolder: DQ Rules
		lineageTag: ac9ec913-c853-536b-b73b-f4e9fc5101f3

	/// distinct rules checked
	measure 'Rules Evaluated' = DISTINCTCOUNT ( 'dq_rule_checks'[rule_id] )
		formatString: #,0
		displayFolder: DQ Rules
		lineageTag: 13837ad5-6701-5174-b1df-dc313d699dc9

	/// distinct rules that failed at least one value
	measure 'Rules with Failures' = CALCULATE ( DISTINCTCOUNT ( 'dq_rule_checks'[rule_id] ), 'dq_rule_checks'[failed] > 0 )
		formatString: #,0
		displayFolder: DQ Rules
		lineageTag: c6a1b390-5428-5279-9357-78c04eca59e9

	column rule_check_id
		dataType: string

/// semantic.dq_runs: one row per validated run, figures of its latest correction round.
table dq_runs
	lineageTag: 101f7f8e-c6e1-52cd-bc6e-c8f1d2a3018d

	/// validated_runs: count(run_id)
	measure 'Validated Runs' = DISTINCTCOUNT ( 'dq_runs'[run_id] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: db0036a8-0a45-5947-bacd-471af0c85f71

	/// processed_records: sum(processed)
	measure 'Processed Records' = SUM ( 'dq_runs'[processed] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: 748015fa-455b-5321-a30f-a27bf9b96cf4

	/// valid_records: sum(valid)
	measure 'Valid Records' = SUM ( 'dq_runs'[valid] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: 0c128f1b-f67b-5109-9ffc-4173bde589a5

	/// clean_records: sum(clean_records) = valid + resolved
	measure 'Clean Records' = SUM ( 'dq_runs'[clean_records] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: 44e39d7e-76a7-5da1-89e8-23cf2c504d59

	/// records_with_issues: sum(records_with_issues)
	measure 'Records with Issues' = SUM ( 'dq_runs'[records_with_issues] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: 5f04dbdc-91e5-51cf-a24a-738680c78b58

	/// auto_fixed_records: sum(auto_fixed_records)
	measure 'Auto-Fixed Records' = SUM ( 'dq_runs'[auto_fixed_records] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: 517040a6-28d2-57f6-976e-171b2c3f1e1f

	/// quarantined_records: sum(quarantined)
	measure 'Quarantined Records' = SUM ( 'dq_runs'[quarantined] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: 5c31e59e-7436-567d-9f3d-4e1b7bff8b4c

	/// resolved_records: sum(resolved)
	measure 'Resolved Records' = SUM ( 'dq_runs'[resolved] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: 7ce47dd7-2c17-5353-8a82-9fd80f8feeca

	/// unresolved_records: sum(unresolved_records)
	measure 'Unresolved Records' = SUM ( 'dq_runs'[unresolved_records] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: 219d2637-ba5a-539f-8d1a-62343b5096c8

	/// manually_fixed_records: sum(manually_fixed_records)
	measure 'Manually Fixed Records' = SUM ( 'dq_runs'[manually_fixed_records] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: bf8ed0f6-c72e-51e9-b8ae-e631d6322b36

	/// discarded_records: sum(discarded)
	measure 'Discarded Records' = SUM ( 'dq_runs'[discarded] )
		formatString: #,0
		displayFolder: DQ Records
		lineageTag: 9c8614c7-ae48-59cc-b026-0df314c6cc74

	/// initial_dq_score: valid_records / processed_records
	measure 'Initial DQ Score %' = DIVIDE ( [Valid Records], [Processed Records] )
		formatString: 0.00%
		displayFolder: DQ Scores
		lineageTag: c3d5b349-b63d-5191-81ab-e11063c64b4b

	/// final_dq_score: clean_records / processed_records
	measure 'Final DQ Score %' = DIVIDE ( [Clean Records], [Processed Records] )
		formatString: 0.00%
		displayFolder: DQ Scores
		lineageTag: 340a97ee-ffec-5f46-852c-c518f81199f5

	/// dq_score_uplift: final_dq_score - initial_dq_score (percentage points)
	measure 'DQ Score Uplift (pp)' = [Final DQ Score %] - [Initial DQ Score %]
		formatString: +0.0000%;-0.0000%;0.0000%
		displayFolder: DQ Scores
		lineageTag: 0714dfe8-8130-599f-bc6d-4426f3573ace

	/// auto_fix_rate: auto_fixed_records / records_with_issues
	measure 'Auto-Fix Rate %' = DIVIDE ( [Auto-Fixed Records], [Records with Issues] )
		formatString: 0.0%
		displayFolder: DQ Scores
		lineageTag: 7da40383-b2f9-53f9-85e4-556257a530ab

	/// quarantine_rate: quarantined_records / processed_records
	measure 'Quarantine Rate %' = DIVIDE ( [Quarantined Records], [Processed Records] )
		formatString: 0.00%
		displayFolder: DQ Scores
		lineageTag: bcd7cc01-f30f-560e-b342-6409e4aa577b

	/// resolution_rate: resolved_records / quarantined_records
	measure 'Quarantine Resolution Rate %' = DIVIDE ( [Resolved Records], [Quarantined Records] )
		formatString: 0.000%
		displayFolder: DQ Scores
		lineageTag: 5deaee4e-b432-5e09-b1fe-621b5a4fda95

	column run_id

	partition fact_transaction = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Fact = Source{[Schema = "gold", Item = "fact_transaction"]}[Data],
				    Selected = Table.SelectColumns(Fact, {"transaction_date", "transaction_type", "transaction_status", "channel", "channel_feature", "digital_feature_use", "currency", "transaction_amount", "amount_egp", "transaction_fee", "estimated_channel_cost_egp", "card_type", "merchant_name", "merchant_category", "login_success", "session_duration_seconds", "attempt_count", "failure_reason", "digital_channel_flag", "digital_migration_opportunity", "account_id", "bank_id", "branch_id", "customer_id", "run_id"}),
				    // money stays a decimal number (not fixed decimal): fixed decimal rounds
				    // every intermediate result, e.g. the digital cost per transaction, to 4
				    // places, and Potential Cost Savings would then miss measure_checks.sql
				    // the same split as digital_channel_flag: Digital = Mobile App, Internet
				    // Banking, InstaPay; every other channel (ATM, Branch, POS, Call Center,
				    // System, Other) is Assisted
				    WithGroup = Table.AddColumn(Selected, "channel_group",
				        each if [digital_channel_flag] then "Digital" else "Assisted", type text)
				in
				    WithGroup


# Python environments
.venv/
venv/
env/

# Python cache and tests
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.credentials/
.streamlit/secrets.toml

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
tmp/
temp/

# Data: source files (data/raw/) stay local; pipeline outputs live in
# PostgreSQL (older versions wrote them under data/ too).
# Anchored to the project root, so tests/data/ (the CI test dataset) is kept.
/data/

# Correction templates exported or downloaded into the project root
# (python dq.py export-template, UI downloads)
/*.csv
/*.xlsx

# Local copies of the git repository (e.g. MetaFlow-DQ-backup.git)
/*.git/

# Local infrastructure state
postgres_data/
airflow/logs/
airflow/airflow.cfg
airflow/*.pid
airflow/standalone_admin_password.txt
airflow/simple_auth_manager_passwords.json.generated

# Local databases
*.db
*.sqlite
*.sqlite3

# dbt build output
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

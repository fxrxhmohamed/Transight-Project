# PostgreSQL: every pipeline output (bronze, dq, silver, metrics).
# Read by docker compose and by dq.py; copy to .env to change them.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metaflow
POSTGRES_USER=metaflow
POSTGRES_PASSWORD=change_me_local_only

# Instead of the POSTGRES_* settings: one libpq URL.
# METAFLOW_DB_URL=postgresql://metaflow:change_me_local_only@localhost:5432/metaflow

# Power BI: the last task of every Airflow DAG (python dq.py powerbi-refresh)
# refreshes this semantic model from PostgreSQL. Leave unset to skip it.
# A service principal with Member access to the workspace; see README, "Power BI".
# POWERBI_TENANT_ID=
# POWERBI_CLIENT_ID=
# POWERBI_CLIENT_SECRET=
# POWERBI_WORKSPACE_ID=
# POWERBI_DATASET_ID=
# POWERBI_REFRESH_TIMEOUT=1800

# E-mail on every Airflow DAG run: success, or the failed task with its
# error (airflow/dags/dq_notify.py). Leave DQ_ALERT_EMAIL unset for none.
# For Gmail, SMTP_PASSWORD is an app password (Google account -> Security
# -> 2-Step Verification -> App passwords), not the account password.
# DQ_ALERT_EMAIL=someone@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=sender@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=
